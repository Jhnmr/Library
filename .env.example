# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos
DB_PATH=./database/library.db

# Seguridad
JWT_SECRET=cambiar-este-secret-por-uno-seguro-generado-aleatoriamente
JWT_EXPIRE=24h
BCRYPT_ROUNDS=10

# Almacenamiento
STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE=5368709120
# 5GB en bytes (5 * 1024 * 1024 * 1024)

# Rutas adicionales de discos duros (separadas por comas)
# Ejemplo: ADDITIONAL_STORAGE=/mnt/disk1,/mnt/disk2,D:/Videos,E:/Documents
ADDITIONAL_STORAGE=

# Acceso Remoto
ENABLE_REMOTE_ACCESS=false
REMOTE_DOMAIN=

# Límites de peticiones
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info
